---
import ArrowDown from "@/assets/hero/arrow-down.svg";
import IsaacFrame from "@/assets/hero/isaac-frame.png";
import LogoMark from "@/assets/hero/logo.svg";
import HeroVectors from "@/assets/hero/vectors.svg";
import { Image } from "astro:assets";
---

<section class="relative min-h-svh overflow-hidden bg-primary text-white">
  <!-- Plano rotacionado 31° (secondary #1b1820) — centro em 1510.9, 837 -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-[78%] top-[77%] z-0 hidden h-[65vh] min-h-[420px] w-[60vw] -translate-x-1/2 -translate-y-1/2 rotate-[31.07deg] bg-secondary lg:block"
  ></div>

  <!-- PC header -->
  <header class="flex-row p-8 items-center z-30 hidden lg:flex">
    <Image src={LogoMark} alt="Isaac Machado — monograma I" width={60} height={56} class="h-[min(5.2vh,56px)] w-auto" />
    <span class="font-logo text-[clamp(2rem,2.5vw,3rem)] leading-none text-neutral-strong select-none">saac</span>
  </header>


  <!-- Mobile header -->
  <header class="flex flex-row block p-8 items-center z-30 lg:hidden">
    <Image src={LogoMark} alt="Isaac Machado — monograma I" width={60} height={56} class="h-11 w-auto" />
    <span class="font-logo text-4xl leading-none text-neutral-strong select-none">saac</span>
  </header>

  <!-- ===== Desktop: canvas absoluto (posições = artboard 1920x1080) ===== -->
  <main class="absolute inset-0 hidden lg:block">
    <!-- 01/ — (82, 439) -->
    <p class="absolute left-[4.27%] top-[40.65%] z-20 text-[clamp(0.75rem,0.73vw,0.875rem)] font-semibold tracking-[0.08em] uppercase font-ranade text-neutral">
      01/
    </p>

    <h1 class="absolute left-[4.27%] top-[42.3%] z-20 font-kabel text-[clamp(2.25rem,3.75vw,4.5rem)] leading-[1.2] font-bold tracking-[-0.03em] whitespace-nowrap">
      Full-Stack Developer
    </h1>

    <!-- CTA row — botão branco 245x60 em (134, 571) + link em (413, 585) -->
    <div class="absolute left-[7%] top-[52.9%] z-20 flex items-center gap-1">
      <a
        href="#contato"
        class="inline-flex h-[clamp(48px,5.56vh,60px)] items-center justify-center rounded-[12px] bg-tertiary text-[clamp(1.125rem,1.25vw,1.5rem)] font-semibold text-ink transition-colors hover:bg-neutral-strong px-8 py-4"
      >
        Conversar comigo
      </a>
      <a href="#projetos" class="text-[clamp(1.125rem,1.25vw,1.5rem)] font-semibold whitespace-nowrap px-8 py-4">
        Visualizar projetos
      </a>
    </div>


    <a href="#sobre" class="absolute left-[55%] top-[60%] z-20 text-[clamp(1.125rem,1.25vw,1.5rem)] font-semibold whitespace-nowrap font-kabel">
      Quem eu sou?
    </a>

    <!-- Seta -->
    <Image
      src={HeroVectors}
      alt=""
      aria-hidden="true"
      width={259}
      height={145}
      class="pointer-events-none absolute top-[44.4%] left-[40.4%] z-10 w-[13.5vw] min-w-[160px]"
    />

    <div class="absolute top-[17.13%] right-[4.22%] bottom-[-16.7%] z-10 w-[38.75%] overflow-hidden">
      <Image
        src={IsaacFrame}
        alt="Retrato de Isaac Machado"
        width={1478}
        height={2137}
        class="h-full w-full object-cover object-top"
      />
    </div>

    <!-- PRINCIPAIS HABILIDADES — label (370, 861) centralizado sobre a linha (129→785) -->
    <div class="absolute left-[6.72%] top-[79.7%] z-20 flex w-[34.2vw] flex-col items-center">
      <p class="text-[clamp(0.75rem,0.73vw,0.875rem)] font-semibold tracking-[0.08em] uppercase">Principais habilidades</p>
      <div class="mt-[clamp(0.5rem,1.46vw,1.55rem)] flex gap-[4.9vw]">
        <div class="aspect-[156/137] w-[8.13vw] rounded-[20px] bg-neutral"></div>
        <div class="aspect-[156/137] w-[8.13vw] rounded-[20px] bg-neutral"></div>
        <div class="aspect-[156/137] w-[8.13vw] rounded-[20px] bg-neutral"></div>
      </div>
    </div>

    <!-- CONTINUE + seta — centro x≈924, label y 1016 -->
    <a href="#experiencia" class="absolute left-[48.13%] top-[93.7%] z-20 flex -translate-x-1/2 flex-col items-center gap-[6px]">
      <p class="text-[clamp(0.75rem,0.73vw,0.875rem)] font-semibold tracking-[0.08em] uppercase">Continue</p>
      <Image src={ArrowDown} alt="" aria-hidden="true" width={24} height={24} class="h-[clamp(18px,1.25vw,24px)] w-auto" />
    </a>
  </main>

  <!-- ===== Mobile: fluxo empilhado ===== -->
  <main class="flex flex-col px-6 pt-8 lg:hidden">
    <p class="text-xs font-semibold tracking-[0.08em] uppercase font-kabel text-neutral">01/</p>
    <h1 class="mt-4 font-kabel text-[2.5rem] leading-[1.2] font-bold tracking-[-0.03em] uppercase">
      Full-Stack Developer
    </h1>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="#contato"
        class="inline-flex items-center justify-center rounded-[12px] bg-tertiary text-lg font-semibold text-ink transition-colors hover:bg-neutral-strong px-8 py-4"
      >
        Conversar comigo
      </a>
      <a href="#projetos" class="inline-flex h-[52px] items-center text-lg font-semibold whitespace-nowrap">
        Visualizar projetos
      </a>
    </div>
    <a href="#sobre" class="mt-4 text-lg font-semibold font-kabel">Quem eu sou?</a>

    <div class="relative mx-auto mt-8 aspect-[744/895] w-full max-w-md overflow-hidden rounded-[20px]">
      <Image
        src={IsaacFrame}
        alt="Retrato de Isaac Machado"
        width={1478}
        height={2137}
        class="absolute inset-0 h-full w-full object-cover object-top"
      />
    </div>

    <div class="mt-10 flex flex-col items-center">
      <p class="text-xs font-semibold tracking-[0.08em] uppercase">Principais habilidades</p>
      <div class="mt-4 flex gap-4">
        <div class="aspect-[156/137] w-[100px] rounded-[20px] bg-neutral"></div>
        <div class="aspect-[156/137] w-[100px] rounded-[20px] bg-neutral"></div>
        <div class="aspect-[156/137] w-[100px] rounded-[20px] bg-neutral"></div>
      </div>
    </div>

    <a href="#experiencia" class="mt-10 mb-6 flex flex-col items-center gap-1.5 self-center">
      <p class="text-xs font-semibold tracking-[0.08em] uppercase">Continue</p>
      <Image src={ArrowDown} alt="" aria-hidden="true" width={24} height={24} class="h-5 w-5" />
    </a>
  </main>
</section>
